{
  "name": "hedeflerbir-lms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:status:prod": "dotenv -e .env.hostinger.local --no-expand -- prisma migrate status",
    "db:deploy:prod": "dotenv -e .env.hostinger.local --no-expand -- prisma migrate deploy",
    "db:seed:prod": "dotenv -e .env.hostinger.local --no-expand -v SEED_ALLOW_PRODUCTION=true -- prisma db seed",
    "preflight": "prisma validate && npm run typecheck && npm run lint && npm run build",
    "postinstall": "prisma generate && patch-package"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.1",
    "@prisma/client": "^6.16.2",
    "@react-email/components": "^0.5.7",
    "@react-email/render": "^1.4.0",
    "@react-pdf/renderer": "^4.9.0",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "exceljs": "^4.4.0",
    "geist": "^1.4.2",
    "lucide-react": "^0.544.0",
    "motion": "^12.23.12",
    "next": "^15.5.4",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "papaparse": "^5.7.0",
    "patch-package": "^8.0.1",
    "prisma": "^6.16.2",
    "radix-ui": "^1.4.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.62.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.37.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tsx": "^4.20.5",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.18.6",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.4",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "postcss": "^8.5.32",
    "uuid": "^11.1.1",
    "deepmerge-ts": "^8.0.2",
    "minimatch": "^11.0.1"
  }
}
