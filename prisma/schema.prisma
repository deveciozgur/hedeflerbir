// HedeflerBir LMS — relational model
// Bounded contexts: Identity · Learning · Assignments · Mentoring · Messaging · Engagement

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  /// Runtime queries. On Supabase: the transaction pooler (port 6543, ?pgbouncer=true).
  url       = env("DATABASE_URL")
  /// Migrations and introspection need a session connection (Supabase session pooler, port 5432).
  /// Locally, set it to the same value as DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

// ───────────────────────────── Enums ─────────────────────────────

enum Role {
  STUDENT
  INSTRUCTOR
  MENTOR
  ADMIN
}

enum ProjectProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum SubmissionStatus {
  SUBMITTED
  GRADED
  RETURNED
}

enum AppointmentStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum NotificationType {
  APPOINTMENT_BOOKED
  APPOINTMENT_CANCELLED
  ASSIGNMENT_CREATED
  ASSIGNMENT_DUE
  SUBMISSION_GRADED
  CERTIFICATE_ISSUED
  NEW_MESSAGE
  SYSTEM
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  DROPPED
}

enum LessonType {
  VIDEO
  ARTICLE
  QUIZ
  ASSIGNMENT
  LIVE_SESSION
}

enum QuestionType {
  MULTIPLE_CHOICE
  MULTIPLE_SELECT
  OPEN_ENDED
}

enum AnnouncementPriority {
  LOW
  NORMAL
  HIGH
}

// ─────────────────────────── Identity ────────────────────────────

model User {
  id             String   @id @default(cuid())
  name           String
  surname        String
  email          String   @unique
  passwordHash   String?
  role           Role     @default(STUDENT)
  avatarUrl      String?
  isActive       Boolean  @default(true)
  /// Embedded in the JWT at sign-in; bumping it revokes every existing session (e.g. after a password reset).
  sessionVersion Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  profile             Profile?
  passwordResetTokens PasswordResetToken[]

  taughtCourses         Course[]                 @relation("CourseInstructor")
  enrollments           Enrollment[]
  attendances           SessionAttendance[]
  lessonViews           LessonView[]
  projectProgress       StudentProjectProgress[]
  submissions           Submission[]
  mentorSlots           MentorSlot[]
  appointmentsAsStudent Appointment[]            @relation("AppointmentStudent")
  appointmentsAsMentor  Appointment[]            @relation("AppointmentMentor")
  sentMessages          Message[]                @relation("MessageSender")
  receivedMessages      Message[]                @relation("MessageReceiver")
  notifications         Notification[]
  announcements         Announcement[]
  badges                UserBadge[]
  supportTickets        SupportTicket[]
  lessonProgress        LessonProgress[]
  quizAttempts          QuizAttempt[]
  mentorAvailability    MentorAvailability[]
  certificates          Certificate[]
  feedbackGiven         AssignmentFeedback[]
  learningActivity      LearningActivity[]
  auditLogs             AuditLog[]

  @@index([role])
}

/// Single-use password reset token. Only the SHA-256 hash is stored — a DB leak can't be replayed.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Profile {
  id            String  @id @default(cuid())
  userId        String  @unique
  bio           String? @db.Text
  title         String?
  expertiseArea String?
  /// { linkedin?: string; github?: string; x?: string; website?: string }
  socialLinks   Json    @default("{}")
  /// Student's personal goals — visible to mentors before a session
  goals         String? @db.Text
  /// Mentor's default video-call room, attached to every booked appointment
  meetingUrl    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────── Learning ────────────────────────────

model Course {
  id           String       @id @default(cuid())
  slug         String       @unique
  title        String
  description  String       @db.Text
  coverUrl     String?
  level        CourseLevel  @default(BEGINNER)
  /// Students only see PUBLISHED courses; ARCHIVED stays readable for enrolled students.
  status       CourseStatus @default(PUBLISHED)
  instructorId String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  instructor    User            @relation("CourseInstructor", fields: [instructorId], references: [id], onDelete: Restrict)
  sessions      CourseSession[]
  modules       CourseModule[]
  assignments   Assignment[]
  enrollments   Enrollment[]
  certificates  Certificate[]
  announcements Announcement[]

  @@index([instructorId])
  @@index([status])
}

model CourseSession {
  id              String   @id @default(cuid())
  courseId        String
  order           Int
  title           String
  description     String?  @db.Text
  scheduleDate    DateTime
  durationMinutes Int      @default(90)
  meetingUrl      String?
  recordingUrl    String?
  /// Array<{ title: string; url: string; type: "pdf" | "link" | "file" }>
  resources       Json     @default("[]")
  createdAt       DateTime @default(now())

  course      Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  attendances SessionAttendance[]
  lessonViews LessonView[]
  lesson      Lesson?

  @@unique([courseId, order])
  @@index([scheduleDate])
}

model Enrollment {
  studentId   String
  courseId    String
  status      EnrollmentStatus @default(ACTIVE)
  enrolledAt  DateTime         @default(now())
  completedAt DateTime?

  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([studentId, courseId])
  @@index([courseId])
}

model SessionAttendance {
  sessionId String
  studentId String
  status    AttendanceStatus

  session CourseSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student User          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([sessionId, studentId])
  @@index([studentId])
}

/// Recording watch state — powers "continue where you left off"
model LessonView {
  userId          String
  sessionId       String
  positionSeconds Int      @default(0)
  completed       Boolean  @default(false)
  updatedAt       DateTime @updatedAt

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  session CourseSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@id([userId, sessionId])
  @@index([userId, updatedAt])
}

/// Course outline: Course > CourseModule > Lesson. Lesson order is per module (orderIndex).
model CourseModule {
  id         String   @id @default(cuid())
  courseId   String
  title      String
  orderIndex Int
  createdAt  DateTime @default(now())

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([courseId, orderIndex])
}

model Lesson {
  id              String     @id @default(cuid())
  moduleId        String
  title           String
  type            LessonType
  orderIndex      Int
  durationMinutes Int?
  /// Markdown body (ARTICLE) or notes shown under a video.
  content         String?    @db.Text
  videoUrl        String?
  /// Array<{ title: string; url: string; type: "pdf" | "link" | "file" }>
  resources       Json       @default("[]")
  /// LIVE_SESSION lessons point at the scheduled session (meeting link, recording, attendance).
  sessionId       String?    @unique
  /// ASSIGNMENT lessons point at the course assignment.
  assignmentId    String?    @unique
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  module     CourseModule     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  session    CourseSession?   @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  assignment Assignment?      @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  quiz       Quiz?
  progress   LessonProgress[]

  @@index([moduleId, orderIndex])
}

model LessonProgress {
  userId            String
  lessonId          String
  isCompleted       Boolean   @default(false)
  lastWatchedSecond Int       @default(0)
  completedAt       DateTime?
  updatedAt         DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([userId, lessonId])
  @@index([lessonId])
}

/// Seconds of video watched per user and calendar day (feeds weekly watch-time analytics).
model LearningActivity {
  userId  String
  day     DateTime @db.Date
  seconds Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
  @@index([day])
}

model Certificate {
  id               String   @id @default(cuid())
  userId           String
  courseId         String
  /// Public verification code printed on the PDF (/verify/<code>).
  verificationCode String   @unique
  issuedAt         DateTime @default(now())
  /// Optional pre-rendered copy; otherwise the PDF is rendered on demand.
  pdfUrl           String?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

// ───────────────────────────── Quizzes ─────────────────────────────

model Quiz {
  id               String @id @default(cuid())
  lessonId         String @unique
  /// Percentage (0-100) needed to pass.
  passingScore     Int    @default(70)
  timeLimitMinutes Int?
  /// Extra attempts after the first one.
  retriesAllowed   Int    @default(2)

  lesson    Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions QuizQuestion[]
  attempts  QuizAttempt[]
}

model QuizQuestion {
  id          String       @id @default(cuid())
  quizId      String
  orderIndex  Int
  prompt      String       @db.Text
  type        QuestionType
  /// Open-ended answers are collected for the instructor and not auto-scored.
  points      Int          @default(1)
  explanation String?      @db.Text

  quiz    Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options QuizOption[]

  @@index([quizId, orderIndex])
}

model QuizOption {
  id         String  @id @default(cuid())
  questionId String
  orderIndex Int
  text       String
  isCorrect  Boolean @default(false)

  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId, orderIndex])
}

model QuizAttempt {
  id           String    @id @default(cuid())
  quizId       String
  userId       String
  /// Percentage of auto-scored points, set when the attempt is submitted.
  score        Int?
  earnedPoints Int?
  maxPoints    Int?
  isPassed     Boolean   @default(false)
  /// { [questionId]: string[] (option ids) | string (open-ended text) }
  answers      Json      @default("{}")
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([quizId, userId])
}

model Project {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  startDate   DateTime
  endDate     DateTime
  createdAt   DateTime @default(now())

  progress StudentProjectProgress[]
}

model StudentProjectProgress {
  id                   String                @id @default(cuid())
  studentId            String
  projectId            String
  completionPercentage Int                   @default(0)
  status               ProjectProgressStatus @default(NOT_STARTED)
  updatedAt            DateTime              @updatedAt

  student User    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([studentId, projectId])
  @@index([projectId])
}

// ────────────────────────── Assignments ──────────────────────────

model Assignment {
  id                String   @id @default(cuid())
  courseId          String
  title             String
  description       String   @db.Text
  dueDate           DateTime
  maxScore          Int      @default(100)
  /// Allowed file extensions, e.g. ["pdf", "zip"]. Empty = the platform default list.
  acceptedFileTypes String[] @default([])
  createdAt         DateTime @default(now())

  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  submissions Submission[]
  lesson      Lesson?

  @@index([courseId, dueDate])
}

model Submission {
  id           String           @id @default(cuid())
  assignmentId String
  studentId    String
  fileUrl      String
  fileName     String?
  note         String?          @db.Text
  status       SubmissionStatus @default(SUBMITTED)
  grade        Int?
  feedback     String?          @db.Text
  submittedAt  DateTime         @default(now())
  gradedAt     DateTime?

  assignment Assignment           @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    User                 @relation(fields: [studentId], references: [id], onDelete: Cascade)
  reviews    AssignmentFeedback[]

  @@unique([assignmentId, studentId])
  @@index([studentId, status])
}

/// Every review round is kept, so the student sees the full feedback history.
/// Submission.grade / feedback / status mirror the latest round.
model AssignmentFeedback {
  id             String           @id @default(cuid())
  submissionId   String
  reviewerId     String?
  /// GRADED = accepted with a score, RETURNED = sent back for revision.
  decision       SubmissionStatus
  score          Int?
  comment        String           @db.Text
  /// Optional reviewer attachment (annotated file, voice note) in storage.
  attachmentKey  String?
  attachmentName String?
  createdAt      DateTime         @default(now())

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewer   User?      @relation(fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([submissionId, createdAt])
}

// ─────────────────────────── Mentoring ───────────────────────────

/// Weekly recurring availability; bookable MentorSlots are generated from it on a rolling window.
/// Times are minutes from midnight in the platform time zone (Europe/Istanbul).
model MentorAvailability {
  id                  String   @id @default(cuid())
  mentorId            String
  /// ISO weekday: 1 = Monday ... 7 = Sunday
  dayOfWeek           Int
  startMinute         Int
  endMinute           Int
  slotDurationMinutes Int      @default(60)
  createdAt           DateTime @default(now())

  mentor User @relation(fields: [mentorId], references: [id], onDelete: Cascade)

  @@index([mentorId, dayOfWeek])
}

model MentorSlot {
  id        String   @id @default(cuid())
  mentorId  String
  startTime DateTime
  endTime   DateTime
  /// true = not bookable: either reserved by a CONFIRMED appointment or closed by the mentor
  isBooked  Boolean  @default(false)
  /// Created from the weekly MentorAvailability template (regenerated when the template changes).
  generated Boolean  @default(false)
  createdAt DateTime @default(now())

  mentor       User          @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@unique([mentorId, startTime])
  @@index([startTime])
}

model Appointment {
  id          String            @id @default(cuid())
  slotId      String
  studentId   String
  mentorId    String
  status      AppointmentStatus @default(CONFIRMED)
  meetingLink String?
  notes       String?           @db.Text
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  slot    MentorSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  student User       @relation("AppointmentStudent", fields: [studentId], references: [id], onDelete: Cascade)
  mentor  User       @relation("AppointmentMentor", fields: [mentorId], references: [id], onDelete: Cascade)

  @@index([slotId])
  @@index([studentId, status])
  @@index([mentorId, status])
}

// ─────────────────────────── Messaging ───────────────────────────

model Message {
  id         String    @id @default(cuid())
  senderId   String
  receiverId String
  parentId   String?
  subject    String
  content    String    @db.Text
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  sender   User      @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User      @relation("MessageReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  parent   Message?  @relation("MessageThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Message[] @relation("MessageThread")

  @@index([receiverId, readAt])
  @@index([senderId, createdAt])
  @@index([parentId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String?
  href      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model SupportTicket {
  id          String       @id @default(cuid())
  requesterId String
  subject     String
  content     String       @db.Text
  status      TicketStatus @default(OPEN)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  requester User @relation(fields: [requesterId], references: [id], onDelete: Cascade)

  @@index([status])
}

// ────────────────────────── Engagement ───────────────────────────

model Announcement {
  id          String               @id @default(cuid())
  authorId    String
  /// null = platform-wide; otherwise only that course's students see it.
  courseId    String?
  title       String
  content     String               @db.Text
  priority    AnnouncementPriority @default(NORMAL)
  pinned      Boolean              @default(false)
  publishedAt DateTime             @default(now())

  author User    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([publishedAt])
  @@index([courseId, publishedAt])
}

model Badge {
  id          String @id @default(cuid())
  code        String @unique
  name        String
  description String
  /// lucide icon name, e.g. "rocket"
  icon        String

  holders UserBadge[]
}

model UserBadge {
  userId    String
  badgeId   String
  awardedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@id([userId, badgeId])
}

// ──────────────────────────── Auditing ────────────────────────────

/// Append-only security trail: sign-ins, role changes, imports and deletions.
model AuditLog {
  id         String   @id @default(cuid())
  /// null for anonymous events (e.g. a failed sign-in for an unknown e-mail).
  actorId    String?
  actorEmail String?
  /// e.g. "auth.login_failed", "user.role_changed" (see modules/administration/domain/audit.ts)
  action     String
  targetType String?
  targetId   String?
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([action, createdAt])
}
