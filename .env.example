# ── Database (PostgreSQL) ─────────────────────────────────
DATABASE_URL="postgresql://hedeflerbir:hedeflerbir@localhost:5432/hedeflerbir?schema=public"

# ── Auth.js ───────────────────────────────────────────────
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
# Production: AUTH_URL="https://app.hedeflerbir.com"

# Optional integrations below are switched on only by real values.
# Empty or "disabled" ⇒ graceful fallback (no crash):
#   Resend  → e-mails are skipped (dev: printed to the console)
#   S3/R2   → uploads go to local disk (UPLOADS_DIR)

# ── Transactional e-mail (Resend) ─────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="HedeflerBir <noreply@hedeflerbir.com>"

# ── File storage (Cloudflare R2 / S3 compatible) ──────────
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET="hedeflerbir-uploads"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""
# Disk fallback location; on hosts that wipe the app folder on redeploy, use a persistent path.
# UPLOADS_DIR=".uploads"

# ── Build ─────────────────────────────────────────────────
# Set to "standalone" for Docker/self-contained deploys (run: node .next/standalone/server.js).
# NEXT_OUTPUT=""

# ── Seed (only for a fresh database) ──────────────────────
SEED_PASSWORD="Hedefler123!"
